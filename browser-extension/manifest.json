{
  "manifest_version": 3,
  "name": "动漫手账 · 存视频",
  "version": "1.1.1",
  "description": "将当前 B 站视频一键保存到本机动漫手账的指定番剧。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "保存当前视频到动漫手账"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "handbook.js"
      ]
    }
  ]
}